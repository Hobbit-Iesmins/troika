# Server-only PostgreSQL connection. Neon pooled URL from Vercel Marketplace is recommended.
# Set DATABASE_URL in Vercel Project Settings > Environment Variables, then redeploy.
# Keep the provider's SSL parameters. Never put the real URL in frontend assets or Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full

# Optional local/CI verification against an isolated test database (npm test).
# TEST_DATABASE_URL=postgresql://USER@127.0.0.1:5432/troika_test?sslmode=disable

# If Supabase requires its public CA certificate, paste the PEM certificate here.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
